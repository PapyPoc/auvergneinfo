---
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const date = post.data.pubDate.toLocaleDateString('fr-FR', {
  day: '2-digit', month: 'long', year: 'numeric'
});
---
<article class="post-card">
  <div class="post-meta">
    <a class="category" href={`${base}categories/${encodeURIComponent(post.data.category.toLowerCase())}/`}>{post.data.category}</a>
    <time datetime={post.data.pubDate.toISOString()}>{date}</time>
  </div>
  <h2><a href={`${base}articles/${post.id}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <div class="tags">
    {post.data.tags.slice(0, 4).map((tag) => <span>#{tag}</span>)}
  </div>
  <a class="read-more" href={`${base}articles/${post.id}/`}>Lire l’article →</a>
</article>
