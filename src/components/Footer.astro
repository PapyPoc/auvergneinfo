---
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map((post) => post.data.category))].sort();
---
<footer class="site-footer">
  <div class="footer-main">
    <div class="container footer-widgets">
      <section class="footer-widget">
        <a class="footer-logo" href={base}>AUVERGNE<span>INFO</span></a>
        <p>AuvergneInfo partage des principes, des retours d’expérience et des guides pratiques autour de l’administration systèmes et réseaux, afin de comprendre, déployer, configurer et dépanner des services d’infrastructure.</p>
      </section>
      <section class="footer-widget">
        <h3>Derniers articles</h3>
        <ul>
          {posts.slice(0, 4).map((post) => <li><a href={`${base}articles/${post.id}/`}>{post.data.title}</a></li>)}
        </ul>
      </section>
      <section class="footer-widget">
        <h3>Catégories</h3>
        <ul>
          {categories.slice(0, 6).map((category) => <li><a href={`${base}categories/${encodeURIComponent(category.toLowerCase())}/`}>{category}</a></li>)}
        </ul>
      </section>
      <section class="footer-widget">
        <h3>Navigation</h3>
        <ul>
          <li><a href={base}>Accueil</a></li>
          <li><a href={`${base}articles/`}>Articles</a></li>
          <li><a href={`${base}a-propos/`}>À propos</a></li>
          <li><a href={`${base}rss.xml`}>Flux RSS</a></li>
        </ul>
      </section>
    </div>
  </div>
  <div class="footer-copyright">
    <div class="container copyright-inner">
      <span>© {new Date().getFullYear()} AuvergneInfo.fr</span>
      <span>Systèmes • Réseaux • Infrastructure</span>
    </div>
  </div>
</footer>
