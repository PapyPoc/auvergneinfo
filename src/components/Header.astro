---
import { getCollection } from 'astro:content';
import { getPostImage } from '../utils/post-image';

const base = import.meta.env.BASE_URL;
const tickerPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const tickerEntries = tickerPosts.map((post) => ({
  post,
  imageSrc: getPostImage(post, base)
}));
---
<header class="site-header">
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-date" aria-label="Date et heure">
        <span class="top-date-icon" aria-hidden="true">▣</span>
        <strong><span id="bloglo-date">Auvergne</span> - <span id="bloglo-time">AuvergneInfo</span></strong>
      </div>
    </div>
  </div>

  <div class="branding-row">
    <div class="container branding-inner branding-banner-only">
      <a class="header-ad header-ad-full" href={base} aria-label="AuvergneInfo, accueil">
        <img
          src={`${base}uploads/2025/12/A.png`}
          alt="AuvergneInfo"
          loading="eager"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
        />
        <span class="header-ad-fallback">AUVERGNEINFO.FR</span>
      </a>
    </div>
  </div>

  <div class="navigation-row">
    <div class="container navigation-inner">
      <div class="social-links" aria-label="Réseaux et flux">
        <a class="social social-rss" href={`${base}rss.xml`} aria-label="Flux RSS" title="Flux RSS">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="5" cy="19" r="2.2" />
            <path d="M3 11.2v3.2a6.6 6.6 0 0 1 6.6 6.6h3.2C12.8 15.6 8.4 11.2 3 11.2Z" />
            <path d="M3 4v3.2c7.6 0 13.8 6.2 13.8 13.8H20C20 11.6 12.4 4 3 4Z" />
          </svg>
        </a>
      </div>

      <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="primary-menu">
        <span></span><span></span><span></span>
        <span class="screen-reader-text">Menu</span>
      </button>

      <nav id="primary-menu" class="primary-menu" aria-label="Navigation principale">
        <a href={base}>Accueil</a>
        <a href={`${base}articles/`}>Articles</a>
        <a href={`${base}a-propos/`}>À propos</a>
      </nav>

      <div class="header-tools">
        <button class="icon-button theme-toggle" type="button" aria-label="Changer le thème">◐</button>
        <a class="icon-button" href={`${base}articles/`} aria-label="Rechercher">⌕</a>
      </div>
    </div>
  </div>

  {tickerEntries.length > 0 && (
    <div class="ticker-wrap">
      <div class="container ticker-shell" data-animated-ticker>
        <div class="ticker-label"><span aria-hidden="true">ϟ</span> Breakings</div>
        <div class="ticker-track" aria-label="Derniers articles">
          <div
            class="ticker-slider"
            style={`--ticker-visible:${Math.min(tickerEntries.length, 3)}`}
            aria-live="off"
          >
            {tickerEntries.map(({ post, imageSrc }) => (
              <a class="ticker-item" href={`${base}articles/${post.id}/`}>
                <span class="ticker-thumb" aria-hidden="true">
                  <img src={imageSrc} alt="" loading="lazy" />
                </span>
                <span class="ticker-copy">
                  <strong>{post.data.title}</strong>
                  <small>{post.data.pubDate.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' })}</small>
                </span>
              </a>
            ))}
          </div>
        </div>
        <button class="ticker-next" type="button" aria-label="Afficher l’article suivant">▶</button>
      </div>
    </div>
  )}
</header>

<style>
  .branding-inner.branding-banner-only {
    min-height: 0;
    display: flex;
    justify-content: center;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .header-ad.header-ad-full {
    display: block;
    justify-self: auto;
    width: min(100%, 1200px);
    height: auto;
    max-width: none;
    overflow: visible;
    background: transparent;
    text-decoration: none;
  }

  .header-ad.header-ad-full img {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
  }

  .social-rss svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  @media (max-width: 720px) {
    .branding-inner.branding-banner-only {
      padding-top: 14px;
      padding-bottom: 14px;
    }
  }

  .ticker-shell .ticker-track {
    display: block;
    overflow: hidden;
  }

  .ticker-slider {
    display: flex;
    width: 100%;
    min-width: 0;
    transform: translateX(0);
    will-change: transform;
  }

  .ticker-slider .ticker-item {
    flex: 0 0 calc(100% / var(--ticker-visible, 3));
    width: calc(100% / var(--ticker-visible, 3));
  }

  .ticker-thumb {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 50%;
    border: 3px solid #fff;
    box-shadow: 0 0 0 1px #dfe5ee;
    background: #e8edf5;
  }

  .ticker-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ticker-next {
    border: 0;
    cursor: pointer;
    font: inherit;
    transition: background .2s ease;
  }

  .ticker-next:hover,
  .ticker-next:focus-visible {
    background: var(--accent);
  }

  @media (max-width: 980px) {
    .ticker-slider {
      --ticker-visible: 2 !important;
    }
  }

  @media (max-width: 640px) {
    .ticker-slider {
      --ticker-visible: 1 !important;
    }

    .ticker-copy strong {
      font-size: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-slider {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const dateNode = document.getElementById('bloglo-date');
    const timeNode = document.getElementById('bloglo-time');
    const updateClock = () => {
      const now = new Date();
      if (dateNode) dateNode.textContent = now.toLocaleDateString('fr-FR', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' });
      if (timeNode) timeNode.textContent = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    };
    updateClock();
    setInterval(updateClock, 1000);

    const toggle = document.querySelector('.mobile-menu-toggle');
    const menu = document.getElementById('primary-menu');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu?.classList.toggle('is-open', !open);
    });

    const themeToggle = document.querySelector('.theme-toggle');
    const stored = localStorage.getItem('auvergneinfo-theme');
    if (stored === 'dark') document.documentElement.dataset.theme = 'dark';
    themeToggle?.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      document.documentElement.dataset.theme = dark ? 'light' : 'dark';
      localStorage.setItem('auvergneinfo-theme', dark ? 'light' : 'dark');
    });

    const ticker = document.querySelector('[data-animated-ticker]');
    const slider = ticker?.querySelector('.ticker-slider');
    const nextButton = ticker?.querySelector('.ticker-next');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = null;
    let animating = false;

    const itemCount = () => slider?.children.length ?? 0;
    const visibleCount = () => {
      if (!slider) return 1;
      const value = Number.parseInt(getComputedStyle(slider).getPropertyValue('--ticker-visible'), 10);
      return Math.max(1, Math.min(Number.isFinite(value) ? value : 3, itemCount()));
    };

    const advanceTicker = () => {
      if (!slider || animating || itemCount() < 2) return;

      const shift = 100 / visibleCount();
      const reduced = reduceMotion.matches;
      animating = true;
      slider.style.transition = reduced ? 'none' : 'transform .55s cubic-bezier(.4,0,.2,1)';
      slider.style.transform = `translateX(-${shift}%)`;

      const finish = () => {
        const first = slider.firstElementChild;
        if (first) slider.appendChild(first);
        slider.style.transition = 'none';
        slider.style.transform = 'translateX(0)';
        void slider.offsetWidth;
        animating = false;
      };

      if (reduced) finish();
      else window.setTimeout(finish, 560);
    };

    const stopTicker = () => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const startTicker = () => {
      stopTicker();
      if (!slider || itemCount() < 2 || reduceMotion.matches) return;
      timer = window.setInterval(advanceTicker, 4200);
    };

    nextButton?.addEventListener('click', () => {
      stopTicker();
      advanceTicker();
      window.setTimeout(startTicker, 700);
    });

    ticker?.addEventListener('pointerenter', stopTicker);
    ticker?.addEventListener('pointerleave', startTicker);
    ticker?.addEventListener('focusin', stopTicker);
    ticker?.addEventListener('focusout', (event) => {
      if (!ticker.contains(event.relatedTarget)) startTicker();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopTicker();
      else startTicker();
    });

    reduceMotion.addEventListener?.('change', startTicker);
    startTicker();
  })();
</script>