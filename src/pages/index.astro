---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPostImage } from '../utils/post-image';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map((post) => post.data.category))].sort();
const base = import.meta.env.BASE_URL;
const mightLike = posts.slice(0, 4).map((post) => ({
  post,
  imageSrc: getPostImage(post, base)
}));
---
<BaseLayout title="AuvergneInfo — Actualités, informations et guides" description="Actualités, informations et guides autour de l’Auvergne.">
  {mightLike.length > 0 && (
    <section class="pyml-section">
      <div class="container">
        <div class="section-title-row">
          <h2>Articles qui pourraient vous plaire</h2>
          <span class="section-title-line"></span>
        </div>
        <div class="pyml-grid">
          {mightLike.map(({ post, imageSrc }) => (
            <a class="pyml-card" href={`${base}articles/${post.id}/`}>
              <span class="pyml-thumb">
                <img src={imageSrc} alt="" loading="lazy" />
              </span>
              <span class="pyml-copy">
                <span class="category">{post.data.category}</span>
                <strong>{post.data.title}</strong>
                <small>◷ {post.data.pubDate.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' })}</small>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="content-section container">
    <div class="content-with-sidebar">
      <div class="feed-column">
        <div class="section-title-row section-title-feed">
          <h1>Dernières actualités</h1>
          <span class="section-title-line"></span>
        </div>
        <div class="post-grid bloglo-masonry">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
      <Sidebar posts={posts} categories={categories} />
    </div>
  </section>
</BaseLayout>
